<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Fitdash.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#050909</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_orb</item>
        <item name="postSplashScreenTheme">@android:style/Theme.Material.NoActionBar</item>
    </style>
    <!-- Soft's light ground; chosen at runtime on Android 13+ once the user is on the Soft theme. -->
    <style name="Theme.Fitdash.Starting.Soft" parent="Theme.Fitdash.Starting">
        <item name="windowSplashScreenBackground">#F2F3F0</item>
    </style>
</resources>
